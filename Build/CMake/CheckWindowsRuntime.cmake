if(NOT DEFINED HP2_DIST_DIR OR NOT DEFINED HP2_RUNTIME_DLL_DIR OR NOT DEFINED HP2_OBJDUMP)
    message(FATAL_ERROR "Windows runtime check requires HP2_DIST_DIR, HP2_RUNTIME_DLL_DIR, and HP2_OBJDUMP")
endif()

set(_hp2_system_dlls
    kernel32.dll kernelbase.dll user32.dll gdi32.dll advapi32.dll shell32.dll
    ole32.dll oleaut32.dll shlwapi.dll ws2_32.dll winmm.dll imm32.dll
    version.dll setupapi.dll opengl32.dll ntdll.dll ucrtbase.dll avrt.dll bcrypt.dll
)
file(GLOB_RECURSE _hp2_initial_binaries LIST_DIRECTORIES FALSE
    "${HP2_DIST_DIR}/*.exe" "${HP2_DIST_DIR}/*.dll")

# Copy non-system runtime imports from llvm-mingw before checking the complete
# tree. The second pass validates imports made by those runtime DLLs as well.
foreach(_hp2_binary IN LISTS _hp2_initial_binaries)
    execute_process(COMMAND "${HP2_OBJDUMP}" -p "${_hp2_binary}"
        RESULT_VARIABLE _hp2_status OUTPUT_VARIABLE _hp2_output ERROR_VARIABLE _hp2_error)
    if(NOT _hp2_status EQUAL 0)
        message(FATAL_ERROR "llvm-objdump failed for ${_hp2_binary}: ${_hp2_error}")
    endif()
    string(REGEX MATCHALL "DLL Name: [^\r\n]+" _hp2_import_lines "${_hp2_output}")
    foreach(_hp2_import_line IN LISTS _hp2_import_lines)
        string(REGEX REPLACE "^DLL Name: *" "" _hp2_dll "${_hp2_import_line}")
        string(TOLOWER "${_hp2_dll}" _hp2_dll_lower)
        if(_hp2_dll_lower MATCHES "^(api-ms-win-|ext-ms-win-)")
            continue()
        endif()
        if(_hp2_dll_lower IN_LIST _hp2_system_dlls)
            continue()
        endif()
        set(_hp2_present FALSE)
        foreach(_hp2_candidate IN LISTS _hp2_initial_binaries)
            get_filename_component(_hp2_candidate_name "${_hp2_candidate}" NAME)
            string(TOLOWER "${_hp2_candidate_name}" _hp2_candidate_lower)
            if(_hp2_candidate_lower STREQUAL _hp2_dll_lower)
                set(_hp2_present TRUE)
                break()
            endif()
        endforeach()
        if(NOT _hp2_present)
            if(EXISTS "${HP2_RUNTIME_DLL_DIR}/${_hp2_dll}")
                file(COPY_FILE "${HP2_RUNTIME_DLL_DIR}/${_hp2_dll}"
                    "${HP2_DIST_DIR}/${_hp2_dll}" ONLY_IF_DIFFERENT)
                list(APPEND _hp2_initial_binaries "${HP2_DIST_DIR}/${_hp2_dll}")
            else()
                message(FATAL_ERROR "missing runtime DLL: ${_hp2_dll}")
            endif()
        endif()
    endforeach()
endforeach()

file(GLOB_RECURSE _hp2_all_binaries LIST_DIRECTORIES FALSE
    "${HP2_DIST_DIR}/*.exe" "${HP2_DIST_DIR}/*.dll")
foreach(_hp2_binary IN LISTS _hp2_all_binaries)
    execute_process(COMMAND "${HP2_OBJDUMP}" -p "${_hp2_binary}"
        RESULT_VARIABLE _hp2_status OUTPUT_VARIABLE _hp2_output ERROR_VARIABLE _hp2_error)
    if(NOT _hp2_status EQUAL 0)
        message(FATAL_ERROR "llvm-objdump failed for ${_hp2_binary}: ${_hp2_error}")
    endif()
    string(REGEX MATCHALL "DLL Name: [^\r\n]+" _hp2_import_lines "${_hp2_output}")
    foreach(_hp2_import_line IN LISTS _hp2_import_lines)
        string(REGEX REPLACE "^DLL Name: *" "" _hp2_dll "${_hp2_import_line}")
        string(TOLOWER "${_hp2_dll}" _hp2_dll_lower)
        if(_hp2_dll_lower MATCHES "^(api-ms-win-|ext-ms-win-)")
            continue()
        endif()
        if(_hp2_dll_lower IN_LIST _hp2_system_dlls)
            continue()
        endif()
        set(_hp2_present FALSE)
        foreach(_hp2_candidate IN LISTS _hp2_all_binaries)
            get_filename_component(_hp2_candidate_name "${_hp2_candidate}" NAME)
            string(TOLOWER "${_hp2_candidate_name}" _hp2_candidate_lower)
            if(_hp2_candidate_lower STREQUAL _hp2_dll_lower)
                set(_hp2_present TRUE)
                break()
            endif()
        endforeach()
        if(NOT _hp2_present)
            message(FATAL_ERROR "missing runtime DLL: ${_hp2_dll}")
        endif()
    endforeach()
endforeach()
